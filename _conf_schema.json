                        "type": "string",
                        "default": ""
                    },
                    "cookies": {
                        "description": "QQ 音乐 Cookies",
                        "hint": "选填。可填写网页端 QQ 音乐 Cookie；仅包含有效 qqmusic_key 或 qm_keyst 的 Cookie 会被发送。",
                        "type": "text",
                        "default": ""
