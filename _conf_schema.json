                        "type": "text",
                        "invisible": true,
                        "default": ""
                    },
                    "proxy": {
                        "description": "代理地址",
                        "hint": "此地址仅用于该音源的网络请求；留空表示直连。示例：http://127.0.0.1:7890。",
                        "type": "string",
                        "default": ""
                    },
                    "enc_sec_key": {
                        "description": "网易云评论密钥",
