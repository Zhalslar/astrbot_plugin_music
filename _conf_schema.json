{
    "default_player_name": {
        "description": "默认点歌平台",
        "hint": "定义点歌命令默认使用的平台。所有平台都支持用命令实时调用：网易点歌、nj点歌、QQ点歌、酷狗点歌、酷我点歌、百度点歌、一听点歌、咪咕点歌、荔枝点歌、蜻蜓点歌、喜马拉雅、5sing原创、5sing翻唱、全民K歌",
        "type": "string",
        "options": [
            "网易点歌",
            "nj点歌",
            "QQ点歌",
            "酷狗点歌",
            "酷我点歌",
            "百度点歌",
            "一听点歌",
            "咪咕点歌",
            "荔枝点歌",
            "蜻蜓点歌",
            "喜马拉雅",
            "5sing原创",
            "5sing翻唱",
            "全民K歌"
        ],
        "default": "网易点歌"
    },
    "nodejs_base_url": {
        "description": "nodejs服务的api根地址",
        "hint": "此项配置决定nodejs服务api的根地址，命令 “nj点歌” 使用的是网易云nodejs服务",
        "type": "string",
        "default": "https://163api.qijieya.cn"
    },
    "song_limit": {
        "description": "搜索歌曲数量限制",
        "hint": "搜索歌曲数量限制",
        "type": "int",
        "slider": {
            "min": 1,
            "max": 20,
            "step": 1
        },
        "default": 5
    },
    "select_modes": {
        "description": "选择模式",
        "hint": "此配置决定搜索歌曲展示方法的优先级，排在前面的模式优先，发送失败时自动尝试下一种模式。单曲模式需要放在第一位",
        "type": "list",
        "options": [
            "button(按钮模式)",
            "image(图片模式)",
            "text(文本模式)",
            "single(单曲模式)"
        ],
        "default": [
            "button(按钮模式)",
            "text(文本模式)",
            "image(图片模式)"
        ]
    },
    "cards_per_row": {
        "description": "候选菜单的列数",
        "type": "int",
        "hint": "定义图片模式下，候选菜单以多少列显示",
        "slider": {
            "min": 1,
            "max": 5,
            "step": 1
        },
        "default": 3
    },
    "send_modes": {
        "description": "发送模式",
        "hint": "此配置决定发送歌曲方式的优先级, 排在前面的模式优先，发送失败时自动尝试下一种模式。 注意: 卡片模式仅 aiocqhttp 平台可用, 链接模式发送较快，本地模式会先下载再发送，文本模式将以链接形式发送",
        "type": "list",
        "options": [
            "card(卡片模式)",
            "cz_card(CZ卡片)",
            "record_link(语音链接)",
            "record_local(本地语音)",
            "file_link(文件链接)",
            "file_local(本地文件)",
            "text(文本模式)"
        ],
        "default": [
            "card(卡片模式)",
            "cz_card(CZ卡片)",
            "record_local(本地语音)",
            "record_link(语音链接)",
            "file_local(本地文件)",
            "file_link(文件链接)",
            "text(文本模式)"
        ]
    },
    "cz_ckey": {
        "description": "CZ API ckey",
        "hint": "选填，填写后可提升 CZ 站点提供的音乐签名接口额度，站点地址：https://api.czcn.xyz",
        "type": "string",
        "default": ""
    },
    "record_unsupported": {
        "description": "不支持发语音的消息平台",
        "hint": "此配置定义哪些消息平台不支持发送语音消息，留空表示所有平台都允许尝试",
        "type": "list",
        "default": []
    },
    "file_unsupported": {
        "description": "不支持发文件的消息平台",
        "hint": "此配置定义哪些消息平台不支持发送文件消息，留空表示所有平台都允许尝试",
        "type": "list",
        "default": []
    },
    "enable_comments": {
        "description": "是否启用评论",
        "hint": "开启后在发送歌曲后附加一条评论",
        "type": "bool",
        "default": true
    },
    "enable_lyrics": {
        "description": "是否启用歌词",
        "hint": "开启后在发送歌曲后附加一张歌曲图片",
        "type": "bool",
        "default": false
    },
    "proxy": {
        "description": "代理地址",
        "hint": "如 http://127.0.0.1:7890，留空则直连。作用于网络请求时",
        "type": "string",
        "default": ""
    },
    "timeout": {
        "description": "点歌操作的超时时长（秒）",
        "hint": "点歌时用户在此时间内没有进行操作则自动取消点歌",
        "type": "int",
        "slider": {
            "min": 30,
            "max": 300,
            "step": 10
        },
        "default": 30
    },
    "recall_select": {
        "description": "撤回选歌消息",
        "hint": "点歌成功后，撤回之前发送的选歌消息",
        "type": "bool",
        "default": true
    },
