{
    "search_config": {
        "description": "搜歌配置",
        "hint": "配置默认音源、搜索结果数量以及候选歌曲的展示和等待方式。",
        "type": "object",
        "items": {
            "default_source": {
                "description": "默认音源",
                "hint": "定义“点歌”命令默认使用的音源；仅可选择已配置并启用的音源。",
                "type": "string",
                "options": [
                    "netease",
                    "netease_nodejs",
                    "qqmusic",
                    "txqq"
                ],
                "labels": [
                    "网易云音乐",
                    "网易云音乐 NodeJS",
                    "QQ 音乐",
                    "TXQQ 聚合音源"
                ],
                "default": "netease"
            },
            "song_limit": {
                "description": "搜索歌曲数量限制",
                "hint": "每次搜索返回的候选歌曲数量；单曲模式时会自动只取 1 首。",
                "type": "int",
                "slider": {
                    "min": 1,
                    "max": 20,
                    "step": 1
                },
                "default": 5
            },
            "select_modes": {
                "description": "选择模式",
                "hint": "按列表顺序尝试选歌展示模式；单曲模式需要放在第一位。",
                "type": "list",
                "options": [
                    "button(按钮模式)",
                    "image(图片模式)",
                    "text(文本模式)",
                    "single(单曲模式)"
                ],
                "default": [
                    "button(按钮模式)",
                    "text(文本模式)",
                    "image(图片模式)"
                ]
            },
            "cards_per_row": {
                "description": "候选菜单的列数",
                "hint": "图片模式下每行显示的歌曲数量。",
                "type": "int",
                "slider": {
                    "min": 1,
                    "max": 5,
                    "step": 1
                },
                "default": 3
            },
            "timeout": {
                "description": "选歌等待超时时长（秒）",
                "hint": "用户收到文本或图片候选列表后，等待其回复序号的最长时间；按钮选择不受此项影响。",
                "type": "int",
                "slider": {
                    "min": 30,
                    "max": 300,
                    "step": 10
                },
                "default": 30
            },
            "recall_select": {
                "description": "点歌成功后撤回选歌消息",
                "hint": "仅在歌曲发送成功后尝试撤回候选列表消息；是否支持取决于当前消息平台。",
                "type": "bool",
                "default": true
            }
        }
    },
    "send_config": {
        "description": "发歌配置",
        "hint": "配置歌曲的发送方式、平台限制，以及发送成功后的附加内容。",
        "type": "object",
        "items": {
            "send_modes": {
                "description": "发送模式",
                "hint": "按列表顺序尝试发送方式，失败时自动尝试下一种。卡片和签名卡片目前仅支持 aiocqhttp。",
                "type": "list",
                "options": [
                    "card(卡片模式)",
                    "ark_card(签名卡片)",
                    "record_link(语音链接)",
                    "record_local(本地语音)",
                    "file_link(文件链接)",
                    "file_local(本地文件)",
                    "text(文本模式)"
                ],
                "default": [
                    "ark_card(签名卡片)",
                    "record_local(本地语音)",
                    "record_link(语音链接)",
                    "file_local(本地文件)",
                    "file_link(文件链接)",
                    "text(文本模式)"
                ]
            },
            "ark_key": {
                "description": "签名卡片 API key",
                "hint": "启用 签名卡片 发送方式时需填写。当前版本推荐使用的站点地址：https://apii.xianyuw.cn，注册后在用户中心复制API令牌填在此处",
                "type": "string",
                "default": ""
            },
            "record_unsupported": {
                "description": "不支持发语音的消息平台",
                "hint": "填写 AstrBot 消息平台名称（如 aiocqhttp），这些平台将跳过语音链接和本地语音方式。留空表示不额外跳过平台。",
                "type": "list",
                "default": []
            },
            "file_unsupported": {
                "description": "不支持发文件的消息平台",
                "hint": "填写 AstrBot 消息平台名称（如 aiocqhttp），这些平台将跳过文件链接和本地文件方式。留空表示不额外跳过平台。",
                "type": "list",
                "default": []
            },
            "enable_comments": {
                "description": "发送热评",
                "hint": "歌曲发送成功后，尝试获取并发送一条热门评论 （需要使用的音源平台支持提供热评）",
                "type": "bool",
                "default": true
            },
            "enable_lyrics": {
                "description": "发送歌词图片",
                "hint": "歌曲发送成功后，尝试获取歌词并渲染为图片发送 （需要使用的音源平台支持提供歌词）",
                "type": "bool",
                "default": false
            },
            "return_play_song_result": {
                "description": "返回点歌结果给LLM",
                "hint": "开启后，当点歌发送成功且没有可用热评时，将歌曲结果返回给 LLM，触发 LLM 回复",
                "type": "bool",
                "default": true
            }
        }
    },
    "players_template": {
        "description": "音乐音源",
        "type": "template_list",
        "hint": "每项对应一个音源。只有已添加且启用的音源会注册；添加新音源时请勿重复添加相同平台。",
        "templates": {
            "netease": {
                "name": "网易云音乐",
                "items": {
                    "enable": {
                        "description": "启用此音源",
